# Public site config — safe to expose (NEXT_PUBLIC_*)
NEXT_PUBLIC_SITE_URL=https://wattsuptech.in
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_EMAIL=hello@wattsuptech.in
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=

# Server only — never expose to client
# CONTACT_NOTIFY_EMAIL=hello@wattsuptech.in
# RATE_LIMIT_MAX=20

# MongoDB (optional — if empty, site uses local JSON file storage in data/)
# Get from MongoDB Atlas: https://cloud.mongodb.com → Connect → copy string
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=wattsuptech

# Email notifications (optional — if empty, submissions are only stored, no email sent)
# Works with Gmail App Password, Brevo, SendGrid, Hostinger, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=WattsUpTech <you@gmail.com>
